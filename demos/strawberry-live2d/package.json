{
  "name": "strawberry-live2d-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "prepare:assets": "node scripts/prepare-reference-assets.mjs",
    "prepare:motion": "node scripts/prepare-reference-assets.mjs && node scripts/prepare-motion-assets.mjs",
    "prepare:audio": "node scripts/prepare-audio.mjs",
    "prepare:texture": "node scripts/pad-runtime-texture.mjs",
    "check:model": "node scripts/check-model.mjs"
  },
  "dependencies": {
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ag-psd": "34.1.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": { "gh-pages": "6.3.0" }
}
